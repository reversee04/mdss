datasource db {
  provider = "postgresql" // Or your preferred database provider
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // Standard output path
}

model Patient {
  patient_id         String      @id @db.VarChar(50)
  nid_or_passport_no String      @db.VarChar(50)
  firstname          String      @db.VarChar(100)
  date_of_birth      DateTime    @db.Date
  sex                String
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  encounters         Encounter[]
}

model Encounter {
  encounter_id        String    @id @db.VarChar(50)
  patient_id          String    @db.VarChar(50)
  facility_id         String    @db.VarChar(50)
  disease_id          String    @db.VarChar(50)
  date_of_diagnosis   DateTime  @db.Date
  admission_date      DateTime? @db.Date
  discharge_date      DateTime? @db.Date
  outcome             String?   @db.Text
  created_at          DateTime  @default(now())
  treatment_record_id String?   @db.VarChar(50)

  patient           Patient           @relation(fields: [patient_id], references: [patient_id])
  facility          Facility          @relation(fields: [facility_id], references: [facility_id])
  disease           Disease           @relation(fields: [disease_id], references: [disease_id])
  treatment_records TreatmentRecord[]
  analyses          Analysis[]
}

model Facility {
  facility_id String      @id @db.VarChar(50)
  name        String      @db.VarChar(100)
  type        String      @db.VarChar(25)
  district    String      @db.VarChar(100)
  region      String      @db.VarChar(100)
  created_at  DateTime    @default(now())
  encounters  Encounter[]
}

model Disease {
  disease_id   String      @id @db.VarChar(50)
  disease_name String      @db.VarChar(100)
  description  String?     @db.Text
  encounters   Encounter[]
}

model Treatment {
  treatment_id      String            @id @db.VarChar(50)
  treatment_name    String            @db.Text
  description       String?           @db.Text
  treatment_records TreatmentRecord[]
}

model TreatmentRecord {
  treatment_record_id String    @id @db.VarChar(50)
  encounter_id        String    @db.VarChar(50)
  treatment_id        String    @db.VarChar(50)
  start_date          DateTime
  end_date            DateTime?
  effectiveness_notes String?   @db.Text

  encounter Encounter @relation(fields: [encounter_id], references: [encounter_id])
  treatment Treatment @relation(fields: [treatment_id], references: [treatment_id])
}

model User {
  user_id       String     @id @db.VarChar(50)
  name          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(100)
  password_hash String     @db.VarChar(50)
  role          String     @db.VarChar(50)
  created_at    DateTime   @default(now())
  reports       Report[]
  audit_logs    AuditLog[]
}

model Analysis {
  analysis_id  String @id @db.VarChar(50)
  treatment_id String @db.VarChar(50)
  encounter_id String @db.VarChar(50)

  encounter Encounter @relation(fields: [encounter_id], references: [encounter_id])
  reports   Report[]
  alerts    Alert[]
}

model Report {
  report_id    String   @id @db.VarChar(50)
  user_id      String   @db.VarChar(50)
  analysis_id  String   @db.VarChar(50)
  report_type  String
  filters_used String?
  generated_at DateTime @default(now())
  file_path    String

  user     User     @relation(fields: [user_id], references: [user_id])
  analysis Analysis @relation(fields: [analysis_id], references: [analysis_id])
}

model Alert {
  alert_id        String   @id @db.VarChar(50)
  analysis_id     String   @db.VarChar(50)
  alert_type      String
  threshold_value String?
  actual_value    String?
  status          String
  created_at      DateTime @default(now())

  analysis Analysis @relation(fields: [analysis_id], references: [analysis_id])
}

model AuditLog {
  log_id          String   @id @db.VarChar(50)
  user_id         String   @db.VarChar(50)
  action          String
  entity_affected String
  timestamp       DateTime @default(now())
  details         String?  @db.Text

  user User @relation(fields: [user_id], references: [user_id])
}

//ENUMS
